# =====================================================
# CORE — conexion a servicios externos
# =====================================================
DATABASE_URL=
API_ROUTE_SECRET=

# =====================================================
# WORKER — comunicacion servidor-a-servidor
# =====================================================
WORKER_INTERNAL_BASE_URL=
WORKER_INTERNAL_PORT=4000
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_MS=2000
WORKER_REPORT_EVERY_CYCLES=12
WORKER_MAX_CONCURRENT=1

# =====================================================
# IA / TRANSCRIPCION / RESUMEN
# =====================================================
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# =====================================================
# STORAGE (S3/MinIO externo)
# =====================================================
STORAGE_PROVIDER=s3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=

# =====================================================
# AUTO-JOIN (Google Calendar)
# =====================================================
AUTO_JOIN_ENABLED=false
AUTO_JOIN_PROVIDER=google
AUTO_JOIN_ORGANIZER_EMAILS=
AUTO_JOIN_POLL_INTERVAL_MS=60000
AUTO_JOIN_LEAD_TIME_MINUTES=5
AUTO_JOIN_LOOKBACK_MINUTES=10
AUTO_JOIN_LOOKAHEAD_MINUTES=60
AUTO_JOIN_DEFAULT_DURATION_MINUTES=60
AUTO_JOIN_REQUIRE_SUPPORTED_LINK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_IMPERSONATE_USER=

# =====================================================
# BOT
# =====================================================
BOT_DEFAULT_NAME=Squaads Bot
MEETING_ADMISSION_TIMEOUT_MS=120000
WAIT_FOR_PARTICIPANTS_TIMEOUT_MS=300000

# =====================================================
# EMAIL (provider agnostico — usado por sharing si aplica)
# =====================================================
EMAIL_PROVIDER=console
DISCORD_BUGREPORT_WEBHOOK_URL=REPLACE_WITH_DISCORD_WEBHOOK_URL
