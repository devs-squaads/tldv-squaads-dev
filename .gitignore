# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/pici_docs

# next.js
/.next/
.next/
/out/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env.development
.env.production
.env.development.remote

# allow base and examples
.env
!.env.development.example
!.env.production.example

# Environment overrides with real secrets (never commit)
.env.dev
.env.prod
.env.dev.railway
.env*.railway

# Service Account keys mounted into the worker container (never commit)
/resources/*
!/resources/.gitkeep

credentials/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Self-Hosted Local First Database
*.db
*.db-journal
*.sqlite
*.sqlite3

# Temporary Bot Media
/pici_docs
*.webm
*.mp4
*.wav
/tmp/
/temp/

# Bot Engine specific built/deps
src/lib/bot/dist/
src/lib/bot/node_modules/

# Chrome extension build output (generated)
apps/extension/dist/

# IDE configs
/.idea

# GGA (local AI review config)
.gga

# gentle-ai / Agent Teams Lite: índice de skills generado por máquina.
# Filtra rutas absolutas locales (C:\Users\...) — no debe versionarse.
.atl/

# Gentle Codegraph: índice de skills generado por máquina.
.codegraph/

# Puente de skills para Claude (symlinks regenerables → .agents/skills/).
# La fuente única versionada es .agents/skills/. Este puente es por-máquina.
.claude/skills/

# Overrides personales de permisos/config de Claude Code, no se versionan.
.claude/settings.local.json

.vercel
