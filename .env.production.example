# Production overrides (copy to .env.production; ignored by git).
# NEVER commit real credentials.

# =========================================================================
# COMUNES
# =========================================================================

# ⚙️ ENVIRONMENT
NODE_ENV=production

# 🗄️ DATABASE (required)
DATABASE_URL=postgresql://user:password@db:5432/meeting_bot
POSTGRES_DB=meeting_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# 🔐 SECURITY (required by web API routes)
API_ROUTE_SECRET=your_secure_random_secret

# 📦 STORAGE BACKEND (required for web/worker)
# For AWS S3: leave S3_ENDPOINT/S3_PUBLIC_ENDPOINT unset.
# For MinIO: set both endpoints explicitly.
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=

# 🧱 MINIO (only if using docker-compose.minio.yml)
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password

# =========================================================================
# DESPLIEGUE DEL SERVICIO WORKER EN VPS
# =========================================================================

# 🤖 AI (required for transcription/summary)
# Transcription: Groq Whisper-large-v3
GROQ_API_KEY=your_groq_api_key
# Summary (worker): Groq/Llama first, falls back to Gemini if needed
GEMINI_API_KEY=your_gemini_api_key

# 🤖 AUTO JOIN
AUTO_JOIN_ORGANIZER_EMAILS=user1@company.com,user2@company.com

# 📅 GOOGLE INTEGRATION (required only if auto-join is enabled)
GOOGLE_CALENDAR_ID=your_calendar_id
GOOGLE_CALENDAR_IMPERSONATE_USER=your_user@company.com

# =========================================================================
# DESPLIEGUE DEL SERVICIO WEB
# =========================================================================

WORKER_INTERNAL_BASE_URL=https://your-worker-host.internal
WORKER_INTERNAL_PORT=4000

# 🔗 SHARING (public + restricted_email)
SHARE_APP_BASE_URL=https://your-domain.com

# ✉️ EMAIL
EMAIL_PROVIDER=your_email_provider
DISCORD_BUGREPORT_WEBHOOK_URL=REPLACE_WITH_DISCORD_WEBHOOK_URL

# 🔑 GOOGLE OAUTH (required for user login via NextAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=your_nextauth_url

# 🔑 SUPER ADMIN (emails que se auto-provisionan como admin activo al loguearse, coma-separado)
SUPER_ADMIN_EMAILS=tu-email@squaads.com
