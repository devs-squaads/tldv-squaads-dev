# Production overrides (copy to .env.production; ignored by git).
# NEVER commit real credentials.

# =========================================================================
# COMUNES
# =========================================================================

# ⚙️ ENVIRONMENT
NODE_ENV=production

# 🗄️ DATABASE (required)
DATABASE_URL=postgresql://user:password@db:5432/meeting_bot
POSTGRES_DB=meeting_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# 🔐 SECURITY (required by web API routes)
API_ROUTE_SECRET=your_secure_random_secret

# 📦 STORAGE BACKEND (required for web/worker)
# For AWS S3: leave S3_ENDPOINT/S3_PUBLIC_ENDPOINT unset.
# For MinIO: set both endpoints explicitly.
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=

# 🧱 MINIO (only if using docker-compose.minio.yml)
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password

# =========================================================================
# DESPLIEGUE DEL SERVICIO WORKER EN VPS
# =========================================================================

# 🤖 AI (required for transcription/summary)
# Transcription: Groq Whisper. El worker extrae y comprime el audio antes de subirlo, así que una
# reunión de horas cabe en el límite del proveedor (antes enviaba el MP4 y fallaba con 413).
GROQ_API_KEY=your_groq_api_key
# Summary/corrección: primero el modelo de texto de Groq, con Gemini como red de seguridad.
GEMINI_API_KEY=your_gemini_api_key

# Identificadores de modelo (opcionales; los valores por defecto están verificados contra las APIs).
# NO pongas aquí un modelo retirado: se descarta con aviso y se usa el valor por defecto.
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash

# 🎙️ VOZ EN TIEMPO REAL DEL CHAT (feature 018) — apagada por defecto.
# El audio del micrófono viaja directo del navegador a Google Gemini Live (requiere GEMINI_API_KEY):
# no se proxea ni se almacena en nuestra infraestructura. La UI avisa antes de pedir el micrófono.
VOICE_CHAT_ENABLED=false
# GEMINI_LIVE_MODEL=gemini-3.8-live
# VOICE_CHAT_MAX_SESSION_MINUTES=15

# Speaker attribution via LLM when the ASR provider does not diarize (default: true)
# SPEAKER_ATTRIBUTION_ENABLED=true

# Rutas a los binarios de ffmpeg (opcional; por defecto se toman del PATH)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# 🤖 AUTO JOIN
AUTO_JOIN_ORGANIZER_EMAILS=user1@company.com,user2@company.com

# 📅 GOOGLE INTEGRATION (required only if auto-join is enabled)
GOOGLE_CALENDAR_ID=your_calendar_id
GOOGLE_CALENDAR_IMPERSONATE_USER=your_user@company.com

# =========================================================================
# DESPLIEGUE DEL SERVICIO WEB
# =========================================================================

WORKER_INTERNAL_BASE_URL=https://your-worker-host.internal
WORKER_INTERNAL_PORT=4000

# 🔗 SHARING (public + restricted_email)
SHARE_APP_BASE_URL=https://your-domain.com

# ✉️ EMAIL
EMAIL_PROVIDER=your_email_provider
DISCORD_BUGREPORT_WEBHOOK_URL=REPLACE_WITH_DISCORD_WEBHOOK_URL

# 🔑 GOOGLE OAUTH (required for user login via NextAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=your_nextauth_url

# 🔑 SUPER ADMIN (emails que se auto-provisionan como admin activo al loguearse, coma-separado)
SUPER_ADMIN_EMAILS=tu-email@squaads.com
