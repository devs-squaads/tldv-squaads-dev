FROM oven/bun:1.3.13 AS bun-base

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

FROM bun-base AS runtime-base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libpulse0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    chromium \
    ffmpeg \
    pulseaudio \
    pulseaudio-utils \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

FROM bun-base AS deps

RUN mkdir -p /app/apps/worker /app/packages/shared

COPY apps/worker/package.json ./apps/worker/package.json
COPY apps/worker/package.root-worker.json ./apps/worker/package.root-worker.json
COPY packages/shared/package.json ./packages/shared/package.json

# Reduced workspace root for the production worker image.
# The split worker must source-run from worker+shared only; bundling changed bot behavior in Meet.
COPY apps/worker/package.root-worker.json ./package.json

RUN bun install --production

FROM deps AS prep

COPY tsconfig.base.json ./tsconfig.base.json
COPY apps/worker ./apps/worker
COPY packages/shared ./packages/shared
COPY scripts/entrypoint.worker.sh ./scripts/entrypoint.worker.sh

RUN sed -i 's/\r$//' /app/scripts/entrypoint.worker.sh && \
    chmod +x /app/scripts/entrypoint.worker.sh

FROM runtime-base AS worker

COPY --from=prep /app/package.json ./package.json
COPY --from=prep /app/tsconfig.base.json ./tsconfig.base.json
COPY --from=prep /app/node_modules ./node_modules
COPY --from=prep /app/apps/worker ./apps/worker
COPY --from=prep /app/packages/shared ./packages/shared
COPY --from=prep /app/scripts/entrypoint.worker.sh ./scripts/entrypoint.worker.sh

CMD ["/bin/bash", "-lc", "sed -i 's/\\r$//' /app/scripts/entrypoint.worker.sh && exec /app/scripts/entrypoint.worker.sh"]
