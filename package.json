{
  "name": "meeting-bot",
  "version": "1.2.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run infra:up && bun run dev:web",
    "dev:web": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_bot S3_ENDPOINT=http://localhost:9000 bun run --cwd apps/web --env-file=../../.env --env-file=../../.env.development dev",
    "dev:remote": "bun run --cwd apps/web --env-file=../../.env --env-file=../../.env.development.remote dev",
    "dev:worker": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_bot S3_ENDPOINT=http://localhost:9000 bun run --cwd apps/worker --env-file=../../.env --env-file=../../.env.development dev",
    "db:push": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_bot bunx drizzle-kit push",
    "infra:up": "docker compose up -d postgres minio mc meeting-worker",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d postgres minio mc meeting-worker",
    "infra:logs": "docker compose logs -f",
    "extension:build": "bun run --cwd apps/extension build",
    "build": "bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "start": "bun run start:web",
    "start:web": "bun run --cwd apps/web start",
    "start:worker": "bun run --cwd apps/worker start",
    "typecheck": "bunx tsc -p packages/shared/tsconfig.json --noEmit && bunx tsc -p apps/worker/tsconfig.json --noEmit && bunx tsc -p apps/web/tsconfig.json --noEmit && bunx tsc -p apps/extension/tsconfig.json --noEmit",
    "test": "bun test apps/__tests__",
    "lint": "eslint apps/web/src apps/worker/src apps/extension/src apps/__tests__ packages/shared/src"
  },
  "devDependencies": {
    "@meeting-bot/shared": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.11",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
