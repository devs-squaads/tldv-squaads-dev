# Local overrides (copy to .env.development; ignored by git).
# Put here only development-specific values and local secrets.

# =========================================================================
# COMUNES
# =========================================================================

# ⚙️ ENVIRONMENT
NODE_ENV=development

# 🗄️ DATABASE (required)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meeting_bot
POSTGRES_DB=meeting_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 🔐 SECURITY (required by web-worker API communication)
API_ROUTE_SECRET=local-secret

# 📦 STORAGE BACKEND (required for web/worker)
# For AWS S3: leave S3_ENDPOINT/S3_PUBLIC_ENDPOINT unset.
# For MinIO: set both endpoints explicitly.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# 🧱 MINIO (only if using docker-compose.minio.yml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin


# =========================================================================
# WORKER (nativo/local)
# =========================================================================

# 🤖 AI (required for transcription/summary)
# Transcription: Groq Whisper-large-v3
GROQ_API_KEY=your_groq_api_key
# Summary (worker): Groq/Llama first, falls back to Gemini if needed
GEMINI_API_KEY=your_gemini_api_key

# 🤖 AUTO JOIN
AUTO_JOIN_ORGANIZER_EMAILS=user1@company.com,user2@company.com

# 📅 GOOGLE INTEGRATION (required only if auto-join is enabled)
GOOGLE_CALENDAR_ID=your_calendar_id
GOOGLE_CALENDAR_IMPERSONATE_USER=your_user@company.com


# =========================================================================
# WEB (nativo/local)
# =========================================================================

WORKER_INTERNAL_BASE_URL=http://meeting-worker:4000
WORKER_INTERNAL_PORT=4000

# 🔗 SHARING (public + restricted_email)
SHARE_APP_BASE_URL=https://your-domain.com

# ✉️ EMAIL
EMAIL_PROVIDER=console

# 🔑 GOOGLE OAUTH (required for user login via NextAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=your_nextauth_url

# 🔑 SUPER ADMIN (emails que se auto-provisionan como admin activo al loguear
SUPER_ADMIN_EMAILS=tu-email@squaads.com